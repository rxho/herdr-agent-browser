+/** A plugin may return a same-machine browser viewer URL as one standalone JSON line.
+ * Restrict this channel to loopback HTTP(S) addresses; the client applies its own framing policy.
+ */
+export function pluginWebPanelUrl(stdout: string | null | undefined): string | null {
+  for (const line of (stdout ?? "").split("\n").reverse()) {
+    let value: unknown;
+    try { value = JSON.parse(line); } catch { continue; }
+    const candidate = (value as { ovis_web_panel_url?: unknown } | null)?.ovis_web_panel_url;
+    if (typeof candidate !== "string" || candidate.length > 2048) continue;
+    try {
+      const url = new URL(candidate);
+      const loopback = ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname);
+      if (!(url.protocol === "https:" || (url.protocol === "http:" && loopback))) continue;
+      if (url.username || url.password || url.search || url.hash) continue;
+      if (!url.pathname.startsWith("/")) continue;
+      return url.href;
+    } catch { /* malformed URL */ }
+  }
+  return null;
+}
