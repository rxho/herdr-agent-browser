{
  "name": "herdr-agent-browser",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "CDP browser session viewer for Herdr",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/browser-e2e.mjs",
    "test:proxy": "node tests/proxy-integration.mjs",
    "test:ovis": "node tests/ovis-local-e2e.mjs",
    "test:mcp-cdp": "node tests/native-shared-cdp-smoke.mjs",
    "test:multi": "node tests/multisession-e2e.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@agent-infra/browser-ui": "0.2.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@puppeteer/browsers": "2.10.13",
    "jsonc-parser": "3.3.1",
    "ws": "^8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "puppeteer-core": "^24.23.0"
  }
}
